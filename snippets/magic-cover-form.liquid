{%- comment -%}
  ============================================================================
  MAGIC COVER FORM SNIPPET
  ============================================================================
  
  Props (required):
    - id_prefix: String - Unique prefix for IDs (typically section.id)
    - settings: Object - Section settings object
  
  Props (optional):
    - product: Product - The selected product (may be blank)
  
  Defaults:
    - None
  
  ============================================================================
{%- endcomment -%}

<div id="magicForm-{{ id_prefix }}" class="magic-form hidden">
  <div class="form-card">
    <h3 class="form-title">Who's in your story?</h3>
    
    <!-- SECTION 1: Main Characters (Required) -->
    <div class="mc-accordion" data-accordion="main-characters">
      <button type="button" class="mc-accordion__header mc-accordion__header--required" aria-expanded="true">
        <span class="mc-accordion__icon">⭐</span>
        <span class="mc-accordion__title">Main Characters <span class="required">*</span></span>
        <span class="mc-accordion__badge" id="mainCharCount-{{ id_prefix }}">0/2</span>
        <span class="mc-accordion__summary hidden" id="mainCharSummary-{{ id_prefix }}"></span>
        <span class="mc-accordion__arrow">▼</span>
      </button>
      <div class="mc-accordion__content" id="mainCharsContent-{{ id_prefix }}">
        <p class="mc-accordion__hint">Add 1-2 main heroes for your story (required)</p>
        
        <div class="mc-photo-grid" id="mainCharsGrid-{{ id_prefix }}">
          <!-- Main Character 1 (Required) -->
          <div class="mc-photo-card mc-photo-card--main" id="mainChar1-{{ id_prefix }}">
            <input type="file" id="mainCharPhoto1-{{ id_prefix }}" class="sr-only" accept="image/*" data-category="main" data-index="1">
            <label for="mainCharPhoto1-{{ id_prefix }}" class="mc-photo-card__upload">
              <div class="mc-photo-card__preview" id="mainCharPreview1-{{ id_prefix }}">
                <span class="mc-photo-card__placeholder">📷</span>
              </div>
              <span class="mc-photo-card__label">Hero 1 *</span>
            </label>
            <input type="text" class="mc-photo-card__name" id="mainCharName1-{{ id_prefix }}" placeholder="Name" data-category="main" data-index="1">
            <select class="mc-photo-card__age" id="mainCharAge1-{{ id_prefix }}" data-category="main" data-index="1">
              <option value="">Age</option>
              {% for i in (1..12) %}
                <option value="{{ i }}">{{ i }} yr</option>
              {% endfor %}
            </select>
          </div>
          
          <!-- Main Character 2 (Optional - for twins/siblings) -->
          <div class="mc-photo-card mc-photo-card--add" id="mainChar2-{{ id_prefix }}">
            <input type="file" id="mainCharPhoto2-{{ id_prefix }}" class="sr-only" accept="image/*" data-category="main" data-index="2">
            <label for="mainCharPhoto2-{{ id_prefix }}" class="mc-photo-card__upload">
              <div class="mc-photo-card__preview" id="mainCharPreview2-{{ id_prefix }}">
                <span class="mc-photo-card__placeholder">➕</span>
              </div>
              <span class="mc-photo-card__label">Add Twin/Co-Hero</span>
            </label>
            <input type="text" class="mc-photo-card__name hidden" id="mainCharName2-{{ id_prefix }}" placeholder="Name" data-category="main" data-index="2">
            <select class="mc-photo-card__age hidden" id="mainCharAge2-{{ id_prefix }}" data-category="main" data-index="2">
              <option value="">Age</option>
              {% for i in (1..12) %}
                <option value="{{ i }}">{{ i }} yr</option>
              {% endfor %}
            </select>
          </div>
        </div>
        
        <span class="field-error hidden" id="mainCharError-{{ id_prefix }}" role="alert">Please add at least one main character with a photo and name</span>
      </div>
    </div>
    
    <!-- SECTION 2: Pets (Optional) - With Owner Assignment -->
    <div class="mc-accordion" data-accordion="pets">
      <button type="button" class="mc-accordion__header" aria-expanded="false">
        <span class="mc-accordion__icon">🐕</span>
        <span class="mc-accordion__title">Pets</span>
        <span class="mc-accordion__badge" id="petCount-{{ id_prefix }}">0/2</span>
        <span class="mc-accordion__arrow">▼</span>
      </button>
      <div class="mc-accordion__content mc-accordion__content--collapsed" id="petsContent-{{ id_prefix }}">
        <p class="mc-accordion__hint">Add pets and assign them to their owner</p>
        
        <div class="mc-photo-grid mc-photo-grid--wide" id="petsGrid-{{ id_prefix }}">
          {% for i in (1..2) %}
            <div class="mc-photo-card mc-photo-card--add mc-photo-card--with-owner" id="pet{{ i }}-{{ id_prefix }}">
              <input type="file" id="petPhoto{{ i }}-{{ id_prefix }}" class="sr-only" accept="image/*" data-category="pet" data-index="{{ i }}">
              <label for="petPhoto{{ i }}-{{ id_prefix }}" class="mc-photo-card__upload">
                <div class="mc-photo-card__preview" id="petPreview{{ i }}-{{ id_prefix }}">
                  <span class="mc-photo-card__placeholder">🐾</span>
                </div>
                <span class="mc-photo-card__label">Add Pet</span>
              </label>
              <div class="mc-photo-card__fields hidden" id="petFields{{ i }}-{{ id_prefix }}">
                <input type="text" class="mc-photo-card__name" id="petName{{ i }}-{{ id_prefix }}" placeholder="Pet's name" data-category="pet" data-index="{{ i }}">
                <select class="mc-photo-card__owner" id="petOwner{{ i }}-{{ id_prefix }}" data-category="pet" data-index="{{ i }}">
                  <option value="everyone">Belongs to: Everyone</option>
                  <!-- Options populated dynamically by JS -->
                </select>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
    
    <!-- SECTION 3: Special Items (Optional) - With Owner Assignment -->
    <div class="mc-accordion" data-accordion="items">
      <button type="button" class="mc-accordion__header" aria-expanded="false">
        <span class="mc-accordion__icon">🧸</span>
        <span class="mc-accordion__title">Special Items</span>
        <span class="mc-accordion__badge" id="itemCount-{{ id_prefix }}">0/3</span>
        <span class="mc-accordion__arrow">▼</span>
      </button>
      <div class="mc-accordion__content mc-accordion__content--collapsed" id="itemsContent-{{ id_prefix }}">
        <p class="mc-accordion__hint">Add favorite toys or objects and assign them to their owner</p>
        
        <div class="mc-photo-grid mc-photo-grid--wide" id="itemsGrid-{{ id_prefix }}">
          {% for i in (1..3) %}
            <div class="mc-photo-card mc-photo-card--add mc-photo-card--with-owner" id="item{{ i }}-{{ id_prefix }}">
              <input type="file" id="itemPhoto{{ i }}-{{ id_prefix }}" class="sr-only" accept="image/*" data-category="item" data-index="{{ i }}">
              <label for="itemPhoto{{ i }}-{{ id_prefix }}" class="mc-photo-card__upload">
                <div class="mc-photo-card__preview" id="itemPreview{{ i }}-{{ id_prefix }}">
                  <span class="mc-photo-card__placeholder">✨</span>
                </div>
                <span class="mc-photo-card__label">Add Item</span>
              </label>
              <div class="mc-photo-card__fields hidden" id="itemFields{{ i }}-{{ id_prefix }}">
                <input type="text" class="mc-photo-card__name" id="itemName{{ i }}-{{ id_prefix }}" placeholder="Item name" data-category="item" data-index="{{ i }}">
                <select class="mc-photo-card__owner" id="itemOwner{{ i }}-{{ id_prefix }}" data-category="item" data-index="{{ i }}">
                  <option value="everyone">Belongs to: Everyone</option>
                  <!-- Options populated dynamically by JS -->
                </select>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
    
    <!-- STORY THEME -->
    <div class="form-field mc-theme-field">
      <label for="storyTheme-{{ id_prefix }}">Story Theme</label>
      <select id="storyTheme-{{ id_prefix }}" class="mc-theme-select">
        <option value="">Choose an adventure...</option>
        <option value="dinosaur">🦕 Dinosaur Discovery</option>
        <option value="space">🚀 Space Explorer</option>
        <option value="princess">👸 Royal Adventure</option>
        <option value="superhero">🦸 Superhero Mission</option>
        <option value="dragon">🐉 Dragon Kingdom</option>
        <option value="unicorn">🦄 Magical Unicorn</option>
        <option value="ocean">🌊 Ocean Adventure</option>
        <option value="jungle">🌴 Jungle Safari</option>
        <option value="custom">✨ Custom (describe below)</option>
      </select>
    </div>
    
    <!-- SPECIAL REQUESTS -->
    <div class="form-field">
      <label for="magicCustom-{{ id_prefix }}">Special Requests <span class="optional">(optional)</span></label>
      <textarea id="magicCustom-{{ id_prefix }}" placeholder="Any special ideas for your story? Custom adventures, specific scenes, or other requests..."></textarea>
    </div>

    <button type="button" id="generateCoverBtn-{{ id_prefix }}" class="generate-btn" aria-busy="false">
      <span class="generate-text">Generate My Preview</span>
      <span class="generate-loading hidden" aria-hidden="true">
        <svg class="spinner" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" fill="none" stroke-dasharray="32" stroke-linecap="round"/></svg>
        Creating magic...
      </span>
    </button>
    <div class="sr-only" aria-live="polite" id="generateStatus-{{ id_prefix }}"></div>
  </div>
</div>
