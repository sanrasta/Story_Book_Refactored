{% doc %}
  @prompt
    "Create a Shopify section featuring a text block (Headline, Subhead, Button) followed immediately by an Automatic Infinite Marquee Gallery.
    
    Gallery Logic: A horizontal strip of 10 uploaded images that loops continuously in a smooth, seamless 'conveyor belt' animation (no pauses/jumps). Images must be unclickable.
    
    Specific Settings: Add a 'Scroll speed' slider (wide range), 'Image width' control, and an 'Image scaling' option ('Fill container' vs 'Fit to image').
    
    Design & Schema: Use a modern, minimal style. Strictly include schema settings to customize all Sizing, Margins, Paddings (top/bottom/desktop/mobile), Text sizes (font-size/line-height), Colors, and Photo dimensions.
    
    Responsive: Ensure fully fluid behavior and vertical stacking for text on mobile.", add border roundness controll on images on gallery
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding-top: {{ block.settings.padding_top_desktop }}px;
    padding-bottom: {{ block.settings.padding_bottom_desktop }}px;
  }

  .ai-marquee-text-wrapper-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto {{ block.settings.text_bottom_margin_desktop }}px;
    padding: 0 20px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-marquee-headline-{{ ai_gen_id }} {
    color: {{ block.settings.headline_color }};
    font-size: {{ block.settings.headline_size_desktop }}px;
    line-height: {{ block.settings.headline_line_height }};
    margin: 0 0 {{ block.settings.headline_bottom_margin }}px;
  }

  .ai-marquee-subhead-{{ ai_gen_id }} {
    color: {{ block.settings.subhead_color }};
    font-size: {{ block.settings.subhead_size_desktop }}px;
    line-height: {{ block.settings.subhead_line_height }};
    margin: 0 0 {{ block.settings.subhead_bottom_margin }}px;
  }

  .ai-marquee-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.button_font_size }}px;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: all 0.3s ease;
  }

  .ai-marquee-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-marquee-gallery-container-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  .ai-marquee-track-{{ ai_gen_id }} {
    display: flex;
    width: max-content;
    animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    gap: {{ block.settings.image_gap }}px;
  }

  .ai-marquee-image-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.image_width }}px;
    height: {{ block.settings.image_height }}px;
    overflow: hidden;
    pointer-events: none;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-marquee-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    {% if block.settings.image_scaling == 'fill' %}
      object-fit: cover;
    {% else %}
      object-fit: contain;
    {% endif %}
    display: block;
  }

  .ai-marquee-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-marquee-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-marquee-section-{{ ai_gen_id }} {
      padding-top: {{ block.settings.padding_top_mobile }}px;
      padding-bottom: {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-marquee-text-wrapper-{{ ai_gen_id }} {
      margin-bottom: {{ block.settings.text_bottom_margin_mobile }}px;
    }

    .ai-marquee-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size_mobile }}px;
    }

    .ai-marquee-subhead-{{ ai_gen_id }} {
      font-size: {{ block.settings.subhead_size_mobile }}px;
    }

    .ai-marquee-image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.image_width_mobile }}px;
      height: {{ block.settings.image_height_mobile }}px;
    }
  }
{% endstyle %}

<infinite-marquee-{{ ai_gen_id }} class="ai-marquee-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-marquee-text-wrapper-{{ ai_gen_id }}">
    {% if block.settings.headline != blank %}
      <h2 class="ai-marquee-headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h2>
    {% endif %}

    {% if block.settings.subhead != blank %}
      <div class="ai-marquee-subhead-{{ ai_gen_id }}">{{ block.settings.subhead }}</div>
    {% endif %}

    {% if block.settings.button_text != blank and block.settings.button_link != blank %}
      <a href="{{ block.settings.button_link }}" class="ai-marquee-button-{{ ai_gen_id }}">
        {{ block.settings.button_text }}
      </a>
    {% endif %}
  </div>

  <div class="ai-marquee-gallery-container-{{ ai_gen_id }}">
    <div class="ai-marquee-track-{{ ai_gen_id }}">
      {% for i in (1..10) %}
        {% assign image_key = 'image_' | append: i %}
        {% assign image = block.settings[image_key] %}
        <div class="ai-marquee-image-wrapper-{{ ai_gen_id }}">
          {% if image %}
            <img
              src="{{ image | image_url: width: 800 }}"
              alt="{{ image.alt | escape }}"
              class="ai-marquee-image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ block.settings.image_width }}"
              height="{{ block.settings.image_height }}"
            >
          {% else %}
            <div class="ai-marquee-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% endfor %}

      {% for i in (1..10) %}
        {% assign image_key = 'image_' | append: i %}
        {% assign image = block.settings[image_key] %}
        <div class="ai-marquee-image-wrapper-{{ ai_gen_id }}">
          {% if image %}
            <img
              src="{{ image | image_url: width: 800 }}"
              alt="{{ image.alt | escape }}"
              class="ai-marquee-image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ block.settings.image_width }}"
              height="{{ block.settings.image_height }}"
            >
          {% else %}
            <div class="ai-marquee-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</infinite-marquee-{{ ai_gen_id }}>

<script>
  (function() {
    class InfiniteMarquee{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-marquee-track-{{ ai_gen_id }}');
        if (this.track) {
          this.track.addEventListener('mouseenter', () => this.pauseAnimation());
          this.track.addEventListener('mouseleave', () => this.resumeAnimation());
        }
      }

      pauseAnimation() {
        if (this.track) {
          this.track.style.animationPlayState = 'paused';
        }
      }

      resumeAnimation() {
        if (this.track) {
          this.track.style.animationPlayState = 'running';
        }
      }
    }

    customElements.define('infinite-marquee-{{ ai_gen_id }}', InfiniteMarquee{{ ai_gen_id }});
  })();
</script>

