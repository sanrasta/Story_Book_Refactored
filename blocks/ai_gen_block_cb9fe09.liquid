{% doc %}
  @prompt
    Create a "Specs Bar" (Trust Band) Shopify Liquid Section using blocks.
    
    1. Layout & Design
    
    Desktop: Single horizontal row with 4 equal columns.
    
    Mobile: Strict 2x2 Grid layout (2 items per row).
    
    Block Content: Stacked vertically: Icon (top), Title (middle), Subtitle (bottom). All text centered.
    
    Style: Compact vertical padding. Light Grey background (#F8F8F8).
    
    2. Content Blocks Each block has: Image/SVG Icon, Title (Bold 600), Subtitle (Dark Grey). Optional thin white border between items.
    
    3. Mandatory Customization (Schema)
    
    Spacing: Range sliders for Top/Bottom Padding and Margins (Separate controls for Desktop & Mobile).
    
    Sizing: Sliders for Section Width and Max-Width.
    
    Typography & Elements: Range sliders for Icon Width (px), Title Font Size (px), and Subtitle Font Size (px) (Separate controls for Desktop & Mobile).
    
    Colors: Color pickers for Background, Title, Subtitle, and Icons.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-specs-bar-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-specs-bar-container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_section_width }}%;
    max-width: {{ block.settings.desktop_max_width }}px;
    margin: 0 auto;
    background-color: {{ block.settings.background_color }};
    padding-top: {{ block.settings.desktop_padding_top }}px;
    padding-bottom: {{ block.settings.desktop_padding_bottom }}px;
  }

  .ai-specs-bar-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }

  .ai-specs-bar-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: {{ block.settings.desktop_item_padding }}px;
    {% if block.settings.show_border %}
      border-right: 1px solid {{ block.settings.border_color }};
    {% endif %}
  }

  .ai-specs-bar-item-{{ ai_gen_id }}:last-child {
    border-right: none;
  }

  .ai-specs-bar-icon-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_icon_width }}px;
    height: auto;
    margin-bottom: 12px;
  }

  .ai-specs-bar-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-specs-bar-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: auto;
    fill: {{ block.settings.icon_color }};
  }

  .ai-specs-bar-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.desktop_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.title_color }};
    margin: 0 0 4px 0;
    line-height: 1.3;
  }

  .ai-specs-bar-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.desktop_subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .ai-specs-bar-container-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_section_width }}%;
      max-width: {{ block.settings.mobile_max_width }}px;
      padding-top: {{ block.settings.mobile_padding_top }}px;
      padding-bottom: {{ block.settings.mobile_padding_bottom }}px;
    }

    .ai-specs-bar-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 0;
    }

    .ai-specs-bar-item-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_item_padding }}px;
      {% if block.settings.show_border %}
        border-right: 1px solid {{ block.settings.border_color }};
        border-bottom: 1px solid {{ block.settings.border_color }};
      {% endif %}
    }

    .ai-specs-bar-item-{{ ai_gen_id }}:nth-child(2n) {
      border-right: none;
    }

    .ai-specs-bar-item-{{ ai_gen_id }}:nth-last-child(-n+2) {
      border-bottom: none;
    }

    .ai-specs-bar-icon-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_icon_width }}px;
      margin-bottom: 8px;
    }

    .ai-specs-bar-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_title_size }}px;
    }

    .ai-specs-bar-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_subtitle_size }}px;
    }
  }
{% endstyle %}

<specs-bar-{{ ai_gen_id }} class="ai-specs-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-specs-bar-container-{{ ai_gen_id }}">
    <div class="ai-specs-bar-grid-{{ ai_gen_id }}">
      {% if block.settings.item_1_title != blank %}
        <div class="ai-specs-bar-item-{{ ai_gen_id }}">
          {% if block.settings.item_1_icon != blank %}
            <div class="ai-specs-bar-icon-{{ ai_gen_id }}">
              <img
                src="{{ block.settings.item_1_icon | image_url: width: 200 }}"
                alt="{{ block.settings.item_1_title | escape }}"
                loading="lazy"
                width="200"
                height="200"
              >
            </div>
          {% endif %}
          <div class="ai-specs-bar-title-{{ ai_gen_id }}">{{ block.settings.item_1_title }}</div>
          {% if block.settings.item_1_subtitle != blank %}
            <div class="ai-specs-bar-subtitle-{{ ai_gen_id }}">{{ block.settings.item_1_subtitle }}</div>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.item_2_title != blank %}
        <div class="ai-specs-bar-item-{{ ai_gen_id }}">
          {% if block.settings.item_2_icon != blank %}
            <div class="ai-specs-bar-icon-{{ ai_gen_id }}">
              <img
                src="{{ block.settings.item_2_icon | image_url: width: 200 }}"
                alt="{{ block.settings.item_2_title | escape }}"
                loading="lazy"
                width="200"
                height="200"
              >
            </div>
          {% endif %}
          <div class="ai-specs-bar-title-{{ ai_gen_id }}">{{ block.settings.item_2_title }}</div>
          {% if block.settings.item_2_subtitle != blank %}
            <div class="ai-specs-bar-subtitle-{{ ai_gen_id }}">{{ block.settings.item_2_subtitle }}</div>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.item_3_title != blank %}
        <div class="ai-specs-bar-item-{{ ai_gen_id }}">
          {% if block.settings.item_3_icon != blank %}
            <div class="ai-specs-bar-icon-{{ ai_gen_id }}">
              <img
                src="{{ block.settings.item_3_icon | image_url: width: 200 }}"
                alt="{{ block.settings.item_3_title | escape }}"
                loading="lazy"
                width="200"
                height="200"
              >
            </div>
          {% endif %}
          <div class="ai-specs-bar-title-{{ ai_gen_id }}">{{ block.settings.item_3_title }}</div>
          {% if block.settings.item_3_subtitle != blank %}
            <div class="ai-specs-bar-subtitle-{{ ai_gen_id }}">{{ block.settings.item_3_subtitle }}</div>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.item_4_title != blank %}
        <div class="ai-specs-bar-item-{{ ai_gen_id }}">
          {% if block.settings.item_4_icon != blank %}
            <div class="ai-specs-bar-icon-{{ ai_gen_id }}">
              <img
                src="{{ block.settings.item_4_icon | image_url: width: 200 }}"
                alt="{{ block.settings.item_4_title | escape }}"
                loading="lazy"
                width="200"
                height="200"
              >
            </div>
          {% endif %}
          <div class="ai-specs-bar-title-{{ ai_gen_id }}">{{ block.settings.item_4_title }}</div>
          {% if block.settings.item_4_subtitle != blank %}
            <div class="ai-specs-bar-subtitle-{{ ai_gen_id }}">{{ block.settings.item_4_subtitle }}</div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</specs-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class SpecsBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('specs-bar-{{ ai_gen_id }}', SpecsBar{{ ai_gen_id }});
  })();
</script>

