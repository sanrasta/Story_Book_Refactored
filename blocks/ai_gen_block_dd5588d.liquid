{% doc %}
  @prompt
    Create a Shopify section called “Exemples de livres personnalisés”
    The section must display 3 example cards, each showing a transformation from a photo to a book cover.
    
    ⸻
    
    🖼️ Card Layout
    
    Each card must include:
    	•	Left image: “Photo utilisée” (the real child photo)
    	•	Right image: “Couverture générée” (the resulting book cover)
    	•	The two images are side-by-side inside one bordered card, same height, equal width.
    	•	Each image has a small caption below:
    	•	Left → “Photo utilisée”
    	•	Right → “Couverture générée”
    
    Below the images, show:
    	•	Titre : (book title)
    	•	Âge : (child’s age)
    	•	Thème : (story theme)
    
    Use a clean label–value format (bold label + regular text).
    
    ⸻
    
    🧩 Grid Settings
    	•	Display exactly 3 cards in a single row on desktop
    	•	On mobile, stack vertically (1 per row)
    	•	Adjustable spacing and border radius
    	•	Add a soft hover effect (slight zoom or lift)
    
    ⸻
    
    🏗️ Section Header
    
    At the top of the section, include:
    	•	Title (editable): “Exemples de livres personnalisés”
    	•	Subtitle (editable): e.g. “Découvrez quelques histoires créées à partir de photos réelles.”
    	•	Optional CTA button under the grid (editable text + link, e.g. “Voir plus d’exemples”)
    
    ⸻
    
    ⚙️ Customization Options
    	•	Upload up to 3 sets of photos (each set = “photo utilisée” + “couverture générée”)
    	•	Add or edit text fields for each example: titre, âge, thème
    	•	Adjustable layout width (full width or contained)
    	•	Adjustable padding top/bottom
    	•	Toggle captions on/off under each image, make the first photo smaller and second bigger with both adjustable width and lenght and also remove the second image text and first image headline should be on top of the photo and the text and the photo could be adjusted by centered or aligned or right , no keep the photo side by side and add a arrow which shows from picture one to second, photos side by side in mobile view and make the arrow stylish way and without background just curved to show the other photo, remove "photo utilisé" caption and make the arrow under the first photo and curved toward second one, no make the arrow small under the first image and curved towards seond image, place the arrow in the empty space under the first photo, in that space that makes size difference between the 2 images, the arrow should start from the first photo looking down then curving to second photo, make the arrow smaller and curving 90 degrees to second photo, add a headline to the text under the images with adjustable color and size and add "photo utilisée" ad caption on top of first image only with also ajstable stuff, and also between these 2 new texts add a horizental line in dots also adjustable in color and spacing between dots and siwe, remove recent changes, add headline to the text under the image with a separator line in adjusted thickness and color
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-book-examples-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-book-examples-container-{{ ai_gen_id }} {
    {% if block.settings.layout_width == 'contained' %}
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    {% else %}
      width: 100%;
      padding: 0 20px;
    {% endif %}
  }

  .ai-book-examples-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-book-examples-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px;
    font-weight: 600;
  }

  .ai-book-examples-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-book-examples-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.card_spacing }}px;
    margin-bottom: 40px;
  }

  .ai-book-examples-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background_color }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-book-examples-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
  }

  .ai-book-examples-images-container-{{ ai_gen_id }} {
    margin-bottom: 20px;
    position: relative;
    min-height: {{ block.settings.second_image_height }}px;
  }

  .ai-book-examples-images-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    justify-content: {{ block.settings.image_alignment }};
    position: relative;
  }

  .ai-book-examples-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    flex-shrink: 0;
  }

  .ai-book-examples-image-wrapper-{{ ai_gen_id }}--first {
    width: {{ block.settings.first_image_width }}px;
  }

  .ai-book-examples-image-wrapper-{{ ai_gen_id }}--second {
    width: {{ block.settings.second_image_width }}px;
  }

  .ai-book-examples-image-{{ ai_gen_id }} {
    width: 100%;
    object-fit: cover;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: block;
  }

  .ai-book-examples-image-{{ ai_gen_id }}--first {
    height: {{ block.settings.first_image_height }}px;
  }

  .ai-book-examples-image-{{ ai_gen_id }}--second {
    height: {{ block.settings.second_image_height }}px;
  }

  .ai-book-examples-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    font-size: 14px;
  }

  .ai-book-examples-image-placeholder-{{ ai_gen_id }}--first {
    height: {{ block.settings.first_image_height }}px;
  }

  .ai-book-examples-image-placeholder-{{ ai_gen_id }}--second {
    height: {{ block.settings.second_image_height }}px;
  }

  .ai-book-examples-image-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.5;
  }

  .ai-book-examples-arrow-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.first_image_height | plus: block.settings.arrow_offset }}px;
    left: calc({{ block.settings.first_image_width }}px / 2 - {{ block.settings.arrow_width }}px / 2);
    width: {{ block.settings.arrow_width }}px;
    height: {{ block.settings.arrow_height }}px;
    z-index: 2;
  }

  .ai-book-examples-arrow-svg-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .ai-book-examples-arrow-path-{{ ai_gen_id }} {
    fill: none;
    stroke: {{ block.settings.arrow_color }};
    stroke-width: {{ block.settings.arrow_thickness }};
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-book-examples-arrow-head-{{ ai_gen_id }} {
    fill: {{ block.settings.arrow_color }};
    stroke: {{ block.settings.arrow_color }};
    stroke-width: 1;
  }

  .ai-book-examples-info-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-book-examples-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    color: {{ block.settings.headline_color }};
    font-weight: 600;
    margin: 0 0 12px;
  }

  .ai-book-examples-separator-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.separator_thickness }}px;
    background-color: {{ block.settings.separator_color }};
    margin: 0 0 16px;
    border: none;
  }

  .ai-book-examples-detail-{{ ai_gen_id }} {
    margin-bottom: 8px;
    font-size: 14px;
    color: {{ block.settings.text_color }};
  }

  .ai-book-examples-detail-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-book-examples-label-{{ ai_gen_id }} {
    font-weight: 600;
    margin-right: 4px;
  }

  .ai-book-examples-cta-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-book-examples-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-weight: 500;
    transition: background-color 0.3s ease;
  }

  .ai-book-examples-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  @media screen and (max-width: 768px) {
    .ai-book-examples-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .ai-book-examples-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-book-examples-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .ai-book-examples-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.9 }}px;
    }

    .ai-book-examples-images-container-{{ ai_gen_id }} {
      min-height: {{ block.settings.second_image_height | times: 0.7 }}px;
    }

    .ai-book-examples-images-{{ ai_gen_id }} {
      gap: 8px;
    }

    .ai-book-examples-image-wrapper-{{ ai_gen_id }}--first {
      width: {{ block.settings.first_image_width | times: 0.7 }}px;
    }

    .ai-book-examples-image-wrapper-{{ ai_gen_id }}--second {
      width: {{ block.settings.second_image_width | times: 0.7 }}px;
    }

    .ai-book-examples-image-{{ ai_gen_id }}--first {
      height: {{ block.settings.first_image_height | times: 0.7 }}px;
    }

    .ai-book-examples-image-{{ ai_gen_id }}--second {
      height: {{ block.settings.second_image_height | times: 0.7 }}px;
    }

    .ai-book-examples-image-placeholder-{{ ai_gen_id }}--first {
      height: {{ block.settings.first_image_height | times: 0.7 }}px;
    }

    .ai-book-examples-image-placeholder-{{ ai_gen_id }}--second {
      height: {{ block.settings.second_image_height | times: 0.7 }}px;
    }

    .ai-book-examples-arrow-{{ ai_gen_id }} {
      top: {{ block.settings.first_image_height | times: 0.7 | plus: block.settings.arrow_offset }}px;
      left: calc({{ block.settings.first_image_width | times: 0.7 }}px / 2 - {{ block.settings.arrow_width | times: 0.8 }}px / 2);
      width: {{ block.settings.arrow_width | times: 0.8 }}px;
      height: {{ block.settings.arrow_height | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-book-examples-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-book-examples-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="ai-book-examples-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-book-examples-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <div class="ai-book-examples-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-book-examples-grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign photo_key = 'example_' | append: i | append: '_photo'
          assign cover_key = 'example_' | append: i | append: '_cover'
          assign headline_key = 'example_' | append: i | append: '_headline'
          assign title_key = 'example_' | append: i | append: '_title'
          assign age_key = 'example_' | append: i | append: '_age'
          assign theme_key = 'example_' | append: i | append: '_theme'

          assign photo = block.settings[photo_key]
          assign cover = block.settings[cover_key]
          assign headline = block.settings[headline_key]
          assign title = block.settings[title_key]
          assign age = block.settings[age_key]
          assign theme = block.settings[theme_key]
        %}

        <div class="ai-book-examples-card-{{ ai_gen_id }}">
          <div class="ai-book-examples-images-container-{{ ai_gen_id }}">
            <div class="ai-book-examples-images-{{ ai_gen_id }}">
              <div class="ai-book-examples-image-wrapper-{{ ai_gen_id }} ai-book-examples-image-wrapper-{{ ai_gen_id }}--first">
                {% if photo %}
                  <img
                    src="{{ photo | image_url: width: 800 }}"
                    alt="Photo utilisée pour {{ title | default: 'exemple ' | append: i }}"
                    class="ai-book-examples-image-{{ ai_gen_id }} ai-book-examples-image-{{ ai_gen_id }}--first"
                    loading="lazy"
                    width="800"
                    height="800"
                  >
                {% else %}
                  <div class="ai-book-examples-image-placeholder-{{ ai_gen_id }} ai-book-examples-image-placeholder-{{ ai_gen_id }}--first">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              <div class="ai-book-examples-image-wrapper-{{ ai_gen_id }} ai-book-examples-image-wrapper-{{ ai_gen_id }}--second">
                {% if cover %}
                  <img
                    src="{{ cover | image_url: width: 800 }}"
                    alt="Couverture générée pour {{ title | default: 'exemple ' | append: i }}"
                    class="ai-book-examples-image-{{ ai_gen_id }} ai-book-examples-image-{{ ai_gen_id }}--second"
                    loading="lazy"
                    width="800"
                    height="800"
                  >
                {% else %}
                  <div class="ai-book-examples-image-placeholder-{{ ai_gen_id }} ai-book-examples-image-placeholder-{{ ai_gen_id }}--second">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
            </div>

            <div class="ai-book-examples-arrow-{{ ai_gen_id }}">
              <svg class="ai-book-examples-arrow-svg-{{ ai_gen_id }}" viewBox="0 0 40 30" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <marker id="arrowhead-{{ ai_gen_id }}-{{ i }}" markerWidth="6" markerHeight="4" 
                   refX="5" refY="2" orient="auto">
                    <polygon class="ai-book-examples-arrow-head-{{ ai_gen_id }}" points="0 0, 6 2, 0 4" />
                  </marker>
                </defs>
                <path class="ai-book-examples-arrow-path-{{ ai_gen_id }}" 
                      d="M 5 5 L 5 15 Q 5 20 10 20 L 30 20" 
                      marker-end="url(#arrowhead-{{ ai_gen_id }}-{{ i }})" />
              </svg>
            </div>
          </div>

          <div class="ai-book-examples-info-{{ ai_gen_id }}">
            {% if headline != blank %}
              <h3 class="ai-book-examples-headline-{{ ai_gen_id }}">{{ headline }}</h3>
              <hr class="ai-book-examples-separator-{{ ai_gen_id }}">
            {% endif %}

            {% if title != blank %}
              <div class="ai-book-examples-detail-{{ ai_gen_id }}">
                <span class="ai-book-examples-label-{{ ai_gen_id }}">Titre :</span>
                {{ title }}
              </div>
            {% endif %}

            {% if age != blank %}
              <div class="ai-book-examples-detail-{{ ai_gen_id }}">
                <span class="ai-book-examples-label-{{ ai_gen_id }}">Âge :</span>
                {{ age }}
              </div>
            {% endif %}

            {% if theme != blank %}
              <div class="ai-book-examples-detail-{{ ai_gen_id }}">
                <span class="ai-book-examples-label-{{ ai_gen_id }}">Thème :</span>
                {{ theme }}
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    {% if block.settings.cta_text != blank and block.settings.cta_link != blank %}
      <div class="ai-book-examples-cta-{{ ai_gen_id }}">
        <a href="{{ block.settings.cta_link }}" class="ai-book-examples-button-{{ ai_gen_id }}">
          {{ block.settings.cta_text }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Livres personnalisés",
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Exemples de livres personnalisés"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>Découvrez quelques histoires créées à partir de photos réelles.</p>"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 32
    },
    {
      "type": "range",
      "id": "subtitle_size",
