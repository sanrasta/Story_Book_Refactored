{% doc %}
  @prompt
    Create a clean, modern 3-step section layout for a website.
    Each step has:
    	•	A numbered circle (1, 2, 3)
    	•	A small illustration or icon
    	•	A short title and 1–2 lines of text below
    
    The layout should display steps horizontally on desktop (in a 3-column grid) and vertically stacked on mobile (with good spacing).
    
    Design style: minimalist, white background, soft shadows, rounded cards, smooth hover effects.
    Use a neutral modern font (like Inter or Poppins).
    Include subtle color accents for the step numbers (e.g., light blue or gradient).
    
    Example structure:
    Step 1: Choose your story
    Step 2: Personalize it
    Step 3: Receive your book
    
    The section should look premium, playful, and family-friendly , photos instead of icons, make the number to the headine, the number is also next to headline text in mobile also, number next to header in mobile view
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-steps-section-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-steps-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-steps-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-steps-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .ai-steps-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    margin: 0;
    line-height: 1.5;
  }

  .ai-steps-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.card_spacing }}px;
    margin-top: {{ block.settings.grid_spacing }}px;
  }

  .ai-step-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    text-align: center;
    box-shadow: 0 {{ block.settings.shadow_vertical }}px {{ block.settings.shadow_blur }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .ai-step-card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: 0 {{ block.settings.shadow_vertical | plus: 5 }}px {{ block.settings.shadow_blur | plus: 10 }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 | times: 1.5 }});
  }

  .ai-step-image-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    margin: 0 auto {{ block.settings.image_spacing }}px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    position: relative;
  }

  .ai-step-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-step-card-{{ ai_gen_id }}:hover .ai-step-image-{{ ai_gen_id }} img {
    transform: scale(1.05);
  }

  .ai-step-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    font-size: 12px;
    text-align: center;
    padding: 10px;
  }

  .ai-step-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-step-title-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: {{ block.settings.number_title_gap }}px;
    margin-bottom: {{ block.settings.title_spacing }}px;
  }

  .ai-step-number-{{ ai_gen_id }} {
    width: {{ block.settings.number_size }}px;
    height: {{ block.settings.number_size }}px;
    border-radius: 50%;
    background: {{ block.settings.accent_color }};
    color: {{ block.settings.number_text_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ block.settings.number_font_size }}px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .ai-step-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.3;
  }

  .ai-step-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_description_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 990px) {
    .ai-steps-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.card_spacing | times: 0.8 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-steps-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px 0 {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-steps-container-{{ ai_gen_id }} {
      padding: 0 16px;
    }

    .ai-steps-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.card_spacing | times: 0.6 }}px;
    }

    .ai-steps-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-step-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
    }

    .ai-step-number-{{ ai_gen_id }} {
      width: {{ block.settings.number_size | times: 0.9 }}px;
      height: {{ block.settings.number_size | times: 0.9 }}px;
      font-size: {{ block.settings.number_font_size | times: 0.9 }}px;
    }

    .ai-step-image-{{ ai_gen_id }} {
      width: {{ block.settings.image_size | times: 0.9 }}px;
      height: {{ block.settings.image_size | times: 0.9 }}px;
    }

    .ai-step-title-wrapper-{{ ai_gen_id }} {
      gap: {{ block.settings.number_title_gap | times: 0.8 }}px;
    }

    .ai-step-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.step_title_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-steps-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-steps-container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank or block.settings.section_subtitle != blank %}
      <div class="ai-steps-header-{{ ai_gen_id }}">
        {% if block.settings.section_title != blank %}
          <h2 class="ai-steps-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
        {% endif %}
        {% if block.settings.section_subtitle != blank %}
          <p class="ai-steps-subtitle-{{ ai_gen_id }}">{{ block.settings.section_subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-steps-grid-{{ ai_gen_id }}">
      <div class="ai-step-card-{{ ai_gen_id }}">
        <div class="ai-step-image-{{ ai_gen_id }}">
          {% if block.settings.step_1_image %}
            <img
              src="{{ block.settings.step_1_image | image_url: width: 400 }}"
              alt="{{ block.settings.step_1_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.step_1_image.width }}"
              height="{{ block.settings.step_1_image.height }}"
            >
          {% else %}
            <div class="ai-step-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        <div class="ai-step-title-wrapper-{{ ai_gen_id }}">
          <div class="ai-step-number-{{ ai_gen_id }}">1</div>
          <h3 class="ai-step-title-{{ ai_gen_id }}">{{ block.settings.step_1_title }}</h3>
        </div>
        <p class="ai-step-description-{{ ai_gen_id }}">{{ block.settings.step_1_description }}</p>
      </div>

      <div class="ai-step-card-{{ ai_gen_id }}">
        <div class="ai-step-image-{{ ai_gen_id }}">
          {% if block.settings.step_2_image %}
            <img
              src="{{ block.settings.step_2_image | image_url: width: 400 }}"
              alt="{{ block.settings.step_2_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.step_2_image.width }}"
              height="{{ block.settings.step_2_image.height }}"
            >
          {% else %}
            <div class="ai-step-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        <div class="ai-step-title-wrapper-{{ ai_gen_id }}">
          <div class="ai-step-number-{{ ai_gen_id }}">2</div>
          <h3 class="ai-step-title-{{ ai_gen_id }}">{{ block.settings.step_2_title }}</h3>
        </div>
        <p class="ai-step-description-{{ ai_gen_id }}">{{ block.settings.step_2_description }}</p>
      </div>

      <div class="ai-step-card-{{ ai_gen_id }}">
        <div class="ai-step-image-{{ ai_gen_id }}">
          {% if block.settings.step_3_image %}
            <img
              src="{{ block.settings.step_3_image | image_url: width: 400 }}"
              alt="{{ block.settings.step_3_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.step_3_image.width }}"
              height="{{ block.settings.step_3_image.height }}"
            >
          {% else %}
            <div class="ai-step-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        <div class="ai-step-title-wrapper-{{ ai_gen_id }}">
          <div class="ai-step-number-{{ ai_gen_id }}">3</div>
          <h3 class="ai-step-title-{{ ai_gen_id }}">{{ block.settings.step_3_title }}</h3>
        </div>
        <p class="ai-step-description-{{ ai_gen_id }}">{{ block.settings.step_3_description }}</p>
      </div>
    </div>
  </div>
</div>

