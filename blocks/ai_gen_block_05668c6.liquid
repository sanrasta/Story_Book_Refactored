{% doc %}
  @prompt
    Create a Shopify section that adds a sticky button to the bottom of the screen with the following requirements:
    
    ⚙️ Functionality
    	•	The button appears only after the user scrolls 20% down the page (make the percentage adjustable in the theme editor).
    	•	Once visible, the button stays fixed at the bottom of the viewport on both desktop and mobile.
    	•	The button disappears again when scrolling back above the trigger point.
    	•	The button links to a customizable URL or popup ID (editable in the theme editor).
    
    🧩 Design & Layout
    	•	The button should be centered horizontally at the bottom.
    	•	Adjustable settings in the editor for:
    	•	Button text
    	•	Link or popup ID
    	•	Background color
    	•	Text color
    	•	Padding
    	•	Border radius
    	•	Font size
    	•	Optional toggle to add a shadow or glow effect for visibility.
    	•	Responsive design — ensure it fits neatly above the mobile nav bar.
    
    🪄 Extras
    	•	Smooth fade-in and fade-out animation when appearing/disappearing.
    	•	Optional setting to make the button span full width or stay centered with max width (both adjustable)., Add optional attention-grabbing animations to the sticky button (make them toggleable via simple settings or code comments):
    	•	Option 1: Light horizontal “shake” every 6 seconds.
    	•	Option 2: Gentle “pulse” effect (scale up to 1.05x) that repeats slowly.
    	•	Option 3: Soft glowing or shining border effect every 10 seconds.
    Each effect should be smooth, subtle, and mobile-friendly.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-sticky-button-{{ ai_gen_id }} {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px);
    transition: opacity 0.4s ease, visibility 0.4s ease, transform 0.4s ease;
    pointer-events: none;
    padding: {{ block.settings.bottom_spacing }}px {{ block.settings.side_spacing }}px;
  }

  .ai-sticky-button-{{ ai_gen_id }}.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .ai-sticky-button-wrapper-{{ ai_gen_id }} {
    {% if block.settings.full_width %}
      width: 100%;
      max-width: {{ block.settings.max_width }}px;
    {% else %}
      width: auto;
      max-width: {{ block.settings.max_width }}px;
    {% endif %}
    margin: 0 auto;
  }

  .ai-sticky-button-link-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.border_radius }}px;
    font-size: {{ block.settings.font_size }}px;
    font-weight: 600;
    text-align: center;
    transition: all 0.3s ease;
    cursor: pointer;
    border: 2px solid transparent;
    position: relative;
    {% if block.settings.enable_shadow %}
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    {% endif %}
    {% if block.settings.enable_glow %}
      box-shadow: 0 0 20px {{ block.settings.button_bg_color }}80;
    {% endif %}
  }

  .ai-sticky-button-link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
    {% if block.settings.enable_shadow %}
      box-shadow: 0 6px 25px rgba(0, 0, 0, 0.2);
    {% endif %}
    {% if block.settings.enable_glow %}
      box-shadow: 0 0 30px {{ block.settings.button_hover_bg_color }}80;
    {% endif %}
  }

  {% if block.settings.animation_type == 'shake' %}
    @keyframes ai-shake-{{ ai_gen_id }} {
      0%, 100% {
        transform: translateX(0);
      }
      10%, 30%, 50%, 70%, 90% {
        transform: translateX(-4px);
      }
      20%, 40%, 60%, 80% {
        transform: translateX(4px);
      }
    }

    .ai-sticky-button-{{ ai_gen_id }}.visible .ai-sticky-button-link-{{ ai_gen_id }} {
      animation: ai-shake-{{ ai_gen_id }} 0.6s ease-in-out 6s infinite;
    }

    .ai-sticky-button-{{ ai_gen_id }}.visible .ai-sticky-button-link-{{ ai_gen_id }}:hover {
      animation: none;
    }
  {% endif %}

  {% if block.settings.animation_type == 'pulse' %}
    @keyframes ai-pulse-{{ ai_gen_id }} {
      0%, 100% {
        transform: scale(1);
      }
      50% {
        transform: scale(1.05);
      }
    }

    .ai-sticky-button-{{ ai_gen_id }}.visible .ai-sticky-button-link-{{ ai_gen_id }} {
      animation: ai-pulse-{{ ai_gen_id }} 2s ease-in-out infinite;
    }

    .ai-sticky-button-{{ ai_gen_id }}.visible .ai-sticky-button-link-{{ ai_gen_id }}:hover {
      animation: none;
      transform: translateY(-2px) scale(1);
    }
  {% endif %}

  {% if block.settings.animation_type == 'glow_border' %}
    @keyframes ai-glow-border-{{ ai_gen_id }} {
      0%, 100% {
        border-color: transparent;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
      }
      5% {
        border-color: {{ block.settings.glow_border_color }};
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15), 0 0 15px {{ block.settings.glow_border_color }}80, inset 0 0 10px {{ block.settings.glow_border_color }}40;
      }
      15% {
        border-color: transparent;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
      }
    }

    .ai-sticky-button-{{ ai_gen_id }}.visible .ai-sticky-button-link-{{ ai_gen_id }} {
      animation: ai-glow-border-{{ ai_gen_id }} 10s ease-in-out infinite;
    }

    .ai-sticky-button-{{ ai_gen_id }}.visible .ai-sticky-button-link-{{ ai_gen_id }}:hover {
      animation: none;
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .ai-sticky-button-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_bottom_spacing }}px {{ block.settings.mobile_side_spacing }}px;
    }

    .ai-sticky-button-link-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_font_size }}px;
      padding: {{ block.settings.mobile_button_padding_vertical }}px {{ block.settings.mobile_button_padding_horizontal }}px;
    }

    {% if block.settings.animation_type == 'shake' %}
      @keyframes ai-shake-{{ ai_gen_id }} {
        0%, 100% {
          transform: translateX(0);
        }
        10%, 30%, 50%, 70%, 90% {
          transform: translateX(-3px);
        }
        20%, 40%, 60%, 80% {
          transform: translateX(3px);
        }
      }
    {% endif %}

    {% if block.settings.animation_type == 'pulse' %}
      @keyframes ai-pulse-{{ ai_gen_id }} {
        0%, 100% {
          transform: scale(1);
        }
        50% {
          transform: scale(1.03);
        }
      }
    {% endif %}
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-sticky-button-{{ ai_gen_id }}.visible .ai-sticky-button-link-{{ ai_gen_id }} {
      animation: none !important;
    }
  }
{% endstyle %}

<sticky-scroll-button-{{ ai_gen_id }}
  class="ai-sticky-button-{{ ai_gen_id }}"
  data-scroll-threshold="{{ block.settings.scroll_threshold }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-sticky-button-wrapper-{{ ai_gen_id }}">
    <a
      href="{{ block.settings.button_link }}"
      class="ai-sticky-button-link-{{ ai_gen_id }}"
    >
      {{ block.settings.button_text }}
    </a>
  </div>
</sticky-scroll-button-{{ ai_gen_id }}>

<script>
  (function() {
    class StickyScrollButton{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.scrollThreshold = parseFloat(this.dataset.scrollThreshold) || 20;
        this.isVisible = false;
      }

      connectedCallback() {
        this.handleScroll = this.handleScroll.bind(this);
        window.addEventListener('scroll', this.handleScroll, { passive: true });
        this.handleScroll();
      }

      disconnectedCallback() {
        window.removeEventListener('scroll', this.handleScroll);
      }

      handleScroll() {
        const scrollPercentage = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
        const shouldShow = scrollPercentage >= this.scrollThreshold;

        if (shouldShow && !this.isVisible) {
          this.classList.add('visible');
          this.isVisible = true;
        } else if (!shouldShow && this.isVisible) {
          this.classList.remove('visible');
          this.isVisible = false;
        }
      }
    }

    customElements.define('sticky-scroll-button-{{ ai_gen_id }}', StickyScrollButton{{ ai_gen_id }});
  })();
</script>

