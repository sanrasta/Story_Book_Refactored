{% doc %}
  @prompt
    Here is a compressed version that fits easily into a single chat message but keeps all the technical details and the 7 specific cards.
    
    Copy & Paste This Prompt:
    Create a "Theme Card Slider" Shopify section.
    
    1. Layout & Behavior:
    
    Desktop: Responsive Grid (customizable columns).
    
    Mobile: Horizontal Scroll/Carousel. Crucial: Set width to show 1.2 to 1.5 cards (peeking effect) with CSS scroll-snapping.
    
    Card Design: Vertical orientation with Cover Image, Badge (floating/top), and Title (bottom).
    
    2. Customization (High Priority):
    
    Do not hardcode sizes. Add Schema settings for: Section margins/padding (mobile/desktop), Grid gaps, Image aspect ratio, Border radius, Font sizes (Title/Badge), and Colors (Backgrounds, Text, Badges, Arrows/Dots).
    
    3. Default Content (Create 7 Blocks): Pre-fill with these themes:
    
    Dinosaures (Tag: 🌟 Unisexe)
    
    Princesse (Tag: 🌸 Fille)
    
    Espace (Tag: 🌟 Unisexe)
    
    Animaux (Tag: 🌟 Unisexe)
    
    Super-Héros (Tag: 🌟 Unisexe)
    
    Voyage (Tag: 🌟 Unisexe)
    
    Football (Tag: 🌟 Unisexe)
    
    4. Style: Modern, minimal, sans-serif typography, and smooth transitions., add where i can add the image in the blocks and make it 7 blocks, mobile columns are not showing 2 when i option to show 2,make sure there's an option to show 2 column in mobile and another whichs shows 1 and another one shows first and half of second, put them as option. and add a hovering arrows for scrolling through the cards, add major headline for all this section with adjusted padding and spacing from the grids, and show also preview of the right arrow for them to know its a slider
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-theme-card-slider-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top_mobile }}px {{ block.settings.section_padding_horizontal_mobile }}px {{ block.settings.section_padding_bottom_mobile }}px;
    position: relative;
  }

  @media screen and (min-width: 750px) {
    .ai-theme-card-slider-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top_desktop }}px {{ block.settings.section_padding_horizontal_desktop }}px {{ block.settings.section_padding_bottom_desktop }}px;
    }
  }

  .ai-theme-card-slider__header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.heading_spacing_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .ai-theme-card-slider__header-{{ ai_gen_id }} {
      margin-bottom: {{ block.settings.heading_spacing_desktop }}px;
    }
  }

  .ai-theme-card-slider__heading-{{ ai_gen_id }} {
    font-family: var(--font-heading-family);
    font-size: {{ block.settings.heading_font_size_mobile }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0;
    text-align: {{ block.settings.heading_alignment }};
  }

  @media screen and (min-width: 750px) {
    .ai-theme-card-slider__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_font_size_desktop }}px;
    }
  }

  .ai-theme-card-slider__container-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-theme-card-slider__grid-{{ ai_gen_id }} {
    display: grid;
    gap: {{ block.settings.grid_gap_mobile }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .ai-theme-card-slider__grid-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .ai-theme-card-slider__grid-{{ ai_gen_id }} {
      {% if block.settings.mobile_layout == '1_column' %}
        grid-auto-flow: column;
        grid-auto-columns: 100%;
      {% elsif block.settings.mobile_layout == '2_columns' %}
        grid-template-columns: repeat(2, 1fr);
        overflow-x: visible;
        scroll-snap-type: none;
      {% elsif block.settings.mobile_layout == 'peek' %}
        grid-auto-flow: column;
        grid-auto-columns: 80%;
        padding-right: {{ block.settings.section_padding_horizontal_mobile }}px;
      {% endif %}
    }
  }

  @media screen and (min-width: 750px) {
    .ai-theme-card-slider__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
      gap: {{ block.settings.grid_gap_desktop }}px;
      overflow-x: visible;
      scroll-snap-type: none;
    }
  }

  .ai-theme-card-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: {{ block.settings.card_background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    scroll-snap-align: start;
    min-width: 0;
  }

  .ai-theme-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .ai-theme-card__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background-color: {{ block.settings.image_placeholder_color }};
  }

  .ai-theme-card__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-theme-card__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-theme-card__placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-theme-card__badge-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.badge_position_top }}px;
    {% if block.settings.badge_align == 'left' %}
      left: {{ block.settings.badge_position_horizontal }}px;
    {% else %}
      right: {{ block.settings.badge_position_horizontal }}px;
    {% endif %}
    background-color: {{ block.settings.badge_background_color }};
    color: {{ block.settings.badge_text_color }};
    padding: {{ block.settings.badge_padding_vertical }}px {{ block.settings.badge_padding_horizontal }}px;
    border-radius: {{ block.settings.badge_border_radius }}px;
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 600;
    text-align: center;
    z-index: 2;
    width: fit-content;
  }

  .ai-theme-card__content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding_vertical }}px {{ block.settings.card_padding_horizontal }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex-grow: 1;
  }

  .ai-theme-card__title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_font_size_mobile }}px;
    font-weight: 600;
    margin: 0;
    font-family: var(--font-heading-family);
  }

  @media screen and (min-width: 750px) {
    .ai-theme-card__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size_desktop }}px;
    }
  }

  .ai-theme-card__link-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-slider-arrow-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    background-color: {{ block.settings.arrow_background_color }};
    border: none;
    border-radius: {{ block.settings.arrow_border_radius }}px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: opacity 0.3s ease, background-color 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  @media screen and (max-width: 749px) {
    .ai-slider-arrow-{{ ai_gen_id }} {
      {% if block.settings.mobile_layout == '2_columns' %}
        display: none;
      {% elsif block.settings.show_arrows_preview %}
        opacity: 1;
      {% else %}
        opacity: 0;
      {% endif %}
    }

    .ai-theme-card-slider-{{ ai_gen_id }}:hover .ai-slider-arrow-{{ ai_gen_id }} {
      opacity: 1;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-slider-arrow-{{ ai_gen_id }} {
      display: none;
    }
  }

  .ai-slider-arrow-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_background_color }};
  }

  .ai-slider-arrow-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-slider-arrow--prev-{{ ai_gen_id }} {
    left: {{ block.settings.arrow_offset }}px;
  }

  .ai-slider-arrow--next-{{ ai_gen_id }} {
    right: {{ block.settings.arrow_offset }}px;
  }

  .ai-slider-arrow-{{ ai_gen_id }} svg {
    width: {{ block.settings.arrow_icon_size }}%;
    height: {{ block.settings.arrow_icon_size }}%;
    fill: {{ block.settings.arrow_icon_color }};
  }
{% endstyle %}

<theme-card-slider-{{ ai_gen_id }} class="ai-theme-card-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <div class="ai-theme-card-slider__header-{{ ai_gen_id }}">
      <h2 class="ai-theme-card-slider__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    </div>
  {% endif %}

  <div class="ai-theme-card-slider__container-{{ ai_gen_id }}">
    <button 
      class="ai-slider-arrow-{{ ai_gen_id }} ai-slider-arrow--prev-{{ ai_gen_id }}" 
      aria-label="Previous"
      data-direction="prev"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
      </svg>
    </button>

    <div class="ai-theme-card-slider__grid-{{ ai_gen_id }}">
      {% for i in (1..7) %}
        {% assign card_image_key = 'card_' | append: i | append: '_image' %}
        {% assign card_title_key = 'card_' | append: i | append: '_title' %}
        {% assign card_badge_key = 'card_' | append: i | append: '_badge' %}
        {% assign card_link_key = 'card_' | append: i | append: '_link' %}
        
        {% assign card_image = block.settings[card_image_key] %}
        {% assign card_title = block.settings[card_title_key] %}
        {% assign card_badge = block.settings[card_badge_key] %}
        {% assign card_link = block.settings[card_link_key] %}
        
        <div class="ai-theme-card-{{ ai_gen_id }}">
          <div class="ai-theme-card__image-wrapper-{{ ai_gen_id }}">
            {% if card_image %}
              <img
                src="{{ card_image | image_url: width: 800 }}"
                alt="{{ card_title | escape }}"
                loading="lazy"
                width="800"
                height="{{ 800 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                class="ai-theme-card__image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-theme-card__placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}

            {% if card_badge != blank %}
              <div class="ai-theme-card__badge-{{ ai_gen_id }}">
                {{ card_badge }}
              </div>
            {% endif %}
          </div>

          <div class="ai-theme-card__content-{{ ai_gen_id }}">
            {% if card_title != blank %}
              <h3 class="ai-theme-card__title-{{ ai_gen_id }}">{{ card_title }}</h3>
            {% endif %}
          </div>

          {% if card_link != blank %}
            <a href="{{ card_link }}" class="ai-theme-card__link-{{ ai_gen_id }}" aria-label="{{ card_title | escape }}"></a>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <button 
      class="ai-slider-arrow-{{ ai_gen_id }} ai-slider-arrow--next-{{ ai_gen_id }}" 
      aria-label="Next"
      data-direction="next"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
      </svg>
    </button>
  </div>
</theme-card-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class ThemeCardSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.grid = this.querySelector('.ai-theme-card-slider__grid-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-slider-arrow--prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-slider-arrow--next-{{ ai_gen_id }}');
        
        if (this.prevButton && this.nextButton) {
          this.setupArrows();
          this.updateArrowStates();
          
          this.grid.addEventListener('scroll', () => {
            this.updateArrowStates();
          });
        }
      }

      setupArrows() {
        this.prevButton.addEventListener('click', () => {
          this.scroll('prev');
        });

        this.nextButton.addEventListener('click', () => {
          this.scroll('next');
        });
      }

      scroll(direction) {
        const cardWidth = this.grid.querySelector('.ai-theme-card-{{ ai_gen_id }}').offsetWidth;
        const gap = parseInt(getComputedStyle(this.grid).gap) || 0;
        const scrollAmount = cardWidth + gap;

        if (direction === 'prev') {
          this.grid.scrollLeft -= scrollAmount;
        } else {
          this.grid.scrollLeft += scrollAmount;
        }
      }

      updateArrowStates() {
        const isAtStart = this.grid.scrollLeft <= 0;
        const isAtEnd = this.grid.scrollLeft + this.grid.offsetWidth >= this.grid.scrollWidth - 1;

        this.prevButton.disabled = isAtStart;
        this.nextButton.disabled = isAtEnd;
      }
    }

    customElements.define('theme-card-slider-{{ ai_gen_id }}', ThemeCardSlider{{ ai_gen_id }});
  })();
</script>

