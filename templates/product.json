ze":18,"step_title_size":20,"step_description_size":13,"number_size":30,"number_font_size":18,"number_title_gap":12,"image_size":120,"image_border_radius":12,"image_spacing":24,"title_spacing":10},"blocks":{}},"ai_gen_block_dd5588d_YcN4Jg":{"type":"ai_gen_block_dd5588d","settings":{"title":"Notre Magie","subtitle":"<p>Découvrez quelques histoires créées à partir de photos réelles.<\/p>","title_size":36,"subtitle_size":16,"title_color":"#fd761c","subtitle_color":"#0e1210","headline_size":18,"headline_color":"#2e2a39","separator_thickness":1,"separator_color":"#fd761c","first_image_width":100,"first_image_height":100,"second_image_width":290,"second_image_height":290,"image_alignment":"center","text_alignment":"left","arrow_width":40,"arrow_height":30,"arrow_offset":10,"arrow_thickness":2,"arrow_color":"#dd1d1d","example_1_photo":"shopify:\/\/shop_images\/yassine.png","example_1_cover":"shopify:\/\/shop_images\/yassine_dinos.jpg","example_1_headline":"Choix de l'histoire","example_1_title":"YASSINE, Les Dinos Ont Besoin de Toi!","example_1_age":"9 ans","example_1_theme":"Dinosaures & Archéologie","example_2_photo":"shopify:\/\/shop_images\/youssra.png","example_2_cover":"shopify:\/\/shop_images\/youssra_princess.png","example_2_headline":"Choix de l'histoire","example_2_title":"PRINCESSE YOUSSRA Celle dont Nous Avons Tous Besoin","example_2_age":"8 ans","example_2_theme":"Princesse & Magie du Cœur","example_3_photo":"shopify:\/\/shop_images\/kido.jpg","example_3_cover":"shopify:\/\/shop_images\/adam_football.png","example_3_headline":"Choix de l'histoire","example_3_title":"ADAM L'Équipe Compte sur Toi!","example_3_age":"7 ans","example_3_theme":"Football & Championnat","cta_text":"","cta_link":"","layout_width":"full_width","padding_top":0,"padding_bottom":0,"card_spacing":16,"card_background_color":"#ffe8d4","card_border_color":"#e5e5e5","card_border_width":1,"card_border_radius":12,"card_padding":20,"image_border_radius":8,"text_color":"#2e2a39","button_background_color":"#dd1d1d","button_text_color":"#ffffff","button_hover_color":"#b81717","button_border_radius":8},"blocks":{}}},"block_order":["ai_gen_block_ff47de7_rxPzFA","ai_gen_block_dd5588d_YcN4Jg"],"settings":{}},"testimonials_r9j3aY":{"type":"testimonials","blocks":{"column_CYnbV4":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/REE.jpg","title":"","text":"<p><em>\"La livraison a pris un peu plus de temps que prévu (presque une semaine pour Casablanca), mais franchement, ça valait l'attente. La qualité du livre est superbe et l'histoire est vraiment personnalisée. Je ne regrette pas.\"<\/em><\/p>","author":"Amira Z."}},"column_cqdCwq":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/rev4.jpg","title":"","text":"<p><em>\"J'ai demandé à changer la photo de couverture au dernier moment et l'équipe sur WhatsApp a été super réactive pour m'aider. Le livre est arrivé très bien emballé. Voir la tête de mon fils quand il s'est reconnu... ça n'a pas de prix !\"<\/em><\/p>","author":"Achraf S."}},"column_ciCJ9p":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/ppp.jpg","title":"","text":"<p><em>\"J'hésitais un peu au début par rapport au prix, mais c'est un vrai livre à couverture rigide, très solide. Ce n'est pas juste une impression rapide. Mon enfant de 5 ans l'adore, c'est devenu son histoire du soir préférée.\"<\/em><\/p>","author":"<strong>Khadija Y.<\/strong>"}},"column_LrXHaD":{"type":"column","disabled":true,"settings":{"image":"shopify:\/\/shop_images\/r2.png","title":"","text":"<p><em>\"Le livre est d'une <\/em><em><strong>qualité superbe<\/strong><\/em><em> et il est très éducatif ! Le service était <\/em><em><strong>rapide et très pro<\/strong><\/em><em>. Ça se voit que c'est un produit <\/em><em><strong>qui vaut le prix<\/strong><\/em><em>. Je suis ravie pour Yanis. Je le recommande sincèrement !\"<\/em><\/p>","author":"<strong>Leila T.<\/strong>"}},"column_QQr84n":{"type":"column","disabled":true,"settings":{"image":"shopify:\/\/shop_images\/Screenshot_2025-10-22_at_17.56.48.png","title":"","text":"<p><em>\"On ne l’a pas encore offert c’est un cadeau pour la naissance de sa sœur incessamment sous peu! Mais en tout cas moi mon mari et ma famille on a été stupéfait la qualité, le réalisme sont là je recommande vivement un très beau souvenir pour la vie\"<\/em><\/p>","author":"<strong>Bouland natacha<\/strong>"}},"column_YdFtKk":{"type":"column","disabled":true,"settings":{"image":"shopify:\/\/shop_images\/review_or_68dce4264b409_1760511259.jpg","title":"","text":"<p><em>\"Très beau livre sur un beau support. La qualité d'impression est parfaite.Je recommande\"<\/em><\/p>","author":"<strong>Bouland natacha<\/strong>"}}},"block_order":["column_CYnbV4","column_cqdCwq","column_ciCJ9p","column_LrXHaD","column_QQr84n","column_YdFtKk"],"name":"Testimonials","settings":{"display_id":false,"visibility":"always-display","title":"<strong>Expériences<\/strong>","title_highlight_color":"#fd761c","heading_size":"h0","text":"<p>Des centaines de sourires grâce à nos livres personnalisés.<br\/><\/p><p><\/p>","color_scheme":"background-1","image_width":"full","image_ratio":"portrait","column_alignment":"center","show_stars":true,"stars_color":"#ffd700","show_quotes":false,"quotes_color_scheme":"accent-2","cards_color_scheme":"bg-overlay","type":"loop","autoplay":false,"autoplay_speed":5,"arrows_color_scheme":"inverse","transparent_arrows":true,"dots_color_scheme":"inverse","desktop_full_page":false,"columns_desktop":3,"slider_desktop":false,"per_move_desktop":1,"desktop_spacing":40,"desktop_side_padding":0,"desktop_padding_calc":true,"desktop_adaptive_height":false,"desktop_dots_position":"under","desktop_arrows_position":"sides","slider_mobile":false,"enable_mobile_preview":false,"mobile_adaptive_height":false,"mobile_dots_position":"under","mobile_arrows_position":"under","padding_top":0,"padding_bottom":0,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#2e2a39","custom_cards_colors_background":"#f3f3f3","custom_cards_gradient_background":"","custom_cards_colors_text":"#2e2a39"}},"collapsible_content_7pffzT":{"type":"collapsible-content","blocks":{"collapsible_row_ryDVYK":{"type":"collapsible_row","settings":{"heading":"Comment fonctionne la création d’un livre personnalisé ?","icon":"check_circle","filled_icon":false,"row_content":"<p>C’est très simple ! Il vous suffit de remplir le formulaire avec les informations de l’enfant (prénom, âge, photo et thème de l’histoire).<\/p><p>Notre équipe vous contactera pour confirmer les détails avant la création du livre.<\/p><p>Une fois validé, nous imprimons le livre personnalisé et le livrons chez vous — le paiement se fait à la livraison.<\/p>","page":""}},"collapsible_row_Vmfhyc":{"type":"collapsible_row","settings":{"heading":"Quels sont les délais de livraison ?","icon":"check_circle","filled_icon":false,"row_content":"<p>Comptez entre <strong>4 et 6 jours ouvrables<\/strong> au total pour recevoir votre livre magique.<\/p><p>Comme chaque livre est une pièce unique créée et imprimée à la demande pour votre enfant, voici les étapes :<\/p><ul><li><strong>Création & Impression (3-4 jours ouvrables) :<\/strong> Nos graphistes et l'IA génèrent l'histoire et les visuels, suivis de l'impression haute qualité.<\/li><li><strong>Expédition (24-48h) :<\/strong> La livraison est ensuite assurée par nos partenaires partout au Maroc.<\/li><\/ul><p>💡 <strong>Conseil important :<\/strong> Si le livre est pour un <strong>anniversaire<\/strong> ou une fête précise, commandez bien à l'avance ! N'oubliez pas que nos délais sont en <strong>jours ouvrables<\/strong> (hors week-ends et jours fériés).<\/p>","page":""}},"collapsible_row_RpAnD7":{"type":"collapsible_row","settings":{"heading":"Puis-je voir un aperçu avant l'impression ?","icon":"check_circle","filled_icon":false,"row_content":"<p>Oui, absolument ! Nous générons gratuitement une <strong>image de la couverture<\/strong> de votre histoire pour vous donner un aperçu du résultat.<\/p><p>Vous pouvez ensuite demander jusqu'à <strong>3 modifications mineures<\/strong> (ajustement de la photo ou du titre) pour être sûr que tout soit parfait avant la production.<\/p>","page":""}},"collapsible_row_weAQV4":{"type":"collapsible_row","settings":{"heading":"Puis-je inventer ma propre histoire ?","icon":"check_circle","filled_icon":false,"row_content":"<p>Oui, avec plaisir ! Remplissez simplement le formulaire avec les informations de l'enfant.<\/p><p>Lorsque nous vous contacterons, expliquez-nous votre idée de scénario. Comme cela demande une création 100% sur mesure, veuillez noter qu'un petit <strong>supplément tarifaire<\/strong> sera appliqué pour ce service spécial.<\/p>","page":""}},"collapsible_row_WKfkHA":{"type":"collapsible_row","settings":{"heading":"Combien coûte un livre personnalisé ?","icon":"check_circle","filled_icon":false,"row_content":"<p>Le prix pour un livre unique est de <strong>399 MAD<\/strong>.<\/p><p>Nous proposons des tarifs dégressifs avantageux si vous commandez pour plusieurs enfants (frères, sœurs, cousins) :<\/p><ul><li><strong>2 livres :<\/strong> 600 MAD (soit 300 MAD l'unité)<\/li><li><strong>3 livres :<\/strong> 800 MAD (soit environ 266 MAD l'unité)<\/li><\/ul><p>Et la livraison est toujours <strong>GRATUITE<\/strong>, quel que soit le nombre de livres commandés !<\/p>","page":""}}},"block_order":["collapsible_row_ryDVYK","collapsible_row_Vmfhyc","collapsible_row_RpAnD7","collapsible_row_weAQV4","collapsible_row_WKfkHA"],"name":"t:sections.collapsible_content.presets.name","settings":{"display_id":false,"visibility":"always-display","caption":"","title":"<strong>Questions Fréquentes<\/strong>","title_highlight_color":"#fd761c","heading_size":"h1","heading_alignment":"center","layout":"none","color_scheme":"background-1","container_color_scheme":"background-2","open_first_collapsible_row":false,"video_muted_autoplay":true,"image_ratio":"adapt","desktop_layout":"image_second","row_heading_size":"medium","collapse_icon":"carret","display_top_border":true,"padding_top":36,"padding_bottom":100,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#2e2a39","custom_contaner_colors_background":"#ffffff","custom_container_gradient_background":"","custom_contaner_colors_text":"#2e2a39"}}},"order":["image_with_text_xDXFij","1760922164ed7dd0c3","main","related-products","blocks_K6GaUQ","testimonials_r9j3aY","collapsible_content_7pffzT"]}