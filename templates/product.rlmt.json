{"sections":{"custom_liquid_UypkYw":{"type":"custom-liquid","disabled":true,"settings":{"display_id":false,"visibility":"always-display","custom_liquid":"<div class='announcement-section-1'>\n <div class='container'>\n  <div class='announcement-wrapper'>\n   <span class='clock-down_text'>\nFlash Sale Ends In<\/span>\n   <div class='holiday-clock' id='js-clock'>\n    <div class='box-3'>\n     <div class='clock-number-2' id='js-clock-hours'>00<\/div>\n     <div class='clock-label-2'>Hrs<\/div>\n    <\/div>\n    <div class='text-block-countdown'>:<\/div>\n    <div class='box-3'>\n     <div class='clock-number-2' id='js-clock-minutes'>00<\/div>\n     <div class='clock-label-2'>Min<\/div>\n    <\/div>\n    <div class='text-block-countdown'>:<\/div>\n    <div class='box-3'>\n     <div class='clock-number-2' id='js-clock-seconds'>00<\/div>\n     <div class='clock-label-2'>Sec<\/div>\n    <\/div>\n   <\/div>\n  <\/div>\n <\/div>\n<\/div>\n\n<style>\n\/********** General Styles **********\/\n.announcement-section-1 {\n    background: #151515;\n    background-size: 400% 400%;\n    animation: primaryGradient 5s ease infinite;\n    color: #fff;\n    text-align: center;\n    padding: 10px 0;\n}\n\n.announcement-wrapper {\n    font-size: 16px;\n    font-weight: 700;\n    line-height: 19.7px;\n    letter-spacing: -0.01em;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 16px;\n}\n\n.holiday-clock {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    color: #151515;\n    border-radius: 3px;\n}\n\n.box-3 {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: center;\n    background-color: #fff;\n    border-radius: 2px;\n    width: 30px;\n    height: 40px;\n    margin: 0 2px;\n    padding: 3px;\n    font-size: 12px;\n    line-height: 20px;\n}\n\n.clock-number-2 {\n    font-size: 14px;\n    font-weight: 900;\n    line-height: 1;\n}\n\n.clock-label-2 {\n    font-size: 8px;\n    line-height: 1;\n    text-transform: uppercase;\n}\n\n.text-block-countdown {\n    color: #fff;\n    padding: 0 2.5px;\n    font-weight: 800;\n}\n\n\/********** Button Styles **********\/\n.atcButton button {\n    background: #039d00 !important;\n    color: #fff;\n    padding: 5px 20px !important;\n    border-radius: 5px;\n    font-size: 13px;\n    min-height: 40px;\n}\n\n\/********** Keyframes **********\/\n@keyframes primaryGradient {\n  0% { background-position: 0% 50%; }\n  50% { background-position: 100% 50%; }\n}\n\n\/********** Media Queries **********\/\n@media (max-width: 740px) {\n    .announcement-wrapper {\n        font-size: 16px;\n        padding: 0px 0;\n        gap: 7px;\n    }\n.clock-number-2 {\n    font-size: 15px!important;\n    font-weight: 900;\n    line-height: 1;\n}\n.clock-label-2 {\n    font-size: 7px!important;\n    line-height: 1;\n    text-transform: uppercase;\n}\n    .holiday-clock {\n        flex-wrap: wrap;\n    }\n\n    .box-3 {\n        width: 25px;\n        height: 28px;\n    }\n\n    .clock-number-2 {\n        font-size: 13px;\n    }\n\n    .clock-label-2 {\n        font-size: 8px;\n    }\n}\n\n@media (max-width: 379px) {\n    .announcement-wrapper {\n        font-size: 15px;\n        gap: 5px;\n    }\n\n    .box-3 {\n        width: 30px;\n        height: 30px;\n    }\n\n    .text-block-countdown {\n        padding: 0 2px;\n    }\n}\n\n@media (max-width: 360px) {\n    .atcButton button {\n        padding-inline: 20px;\n    }\n}\n<\/style>\n\n<script>\n\/\/ Countdown Timer Script\n(function() {\n    const endTime = new Date(\"January 25, 2099 00:00:00\").getTime();\n\n    function updateTimer() {\n        const now = new Date().getTime();\n        const timeLeft = endTime - now;\n\n        if (timeLeft < 0) {\n            document.getElementById('js-clock').innerHTML = '<span>Sale Ended<\/span>';\n            return;\n        }\n\n        const hours = Math.floor((timeLeft % (1000 * 60 * 60 * 24)) \/ (1000 * 60 * 60));\n        const minutes = Math.floor((timeLeft % (1000 * 60 * 60)) \/ (1000 * 60));\n        const seconds = Math.floor((timeLeft % (1000 * 60)) \/ 1000);\n\n        document.getElementById('js-clock-hours').textContent = String(hours).padStart(2, '0');\n        document.getElementById('js-clock-minutes').textContent = String(minutes).padStart(2, '0');\n        document.getElementById('js-clock-seconds').textContent = String(seconds).padStart(2, '0');\n    }\n\n    setInterval(updateTimer, 1000);\n    updateTimer(); \/\/ Initial call to avoid delay\n})();\n<\/script>","color_scheme":"accent-1","padding_top":0,"padding_bottom":0}},"main":{"type":"main-product","blocks":{"custom_liquid_4ppXmC":{"type":"custom_liquid","disabled":true,"settings":{"custom_liquid":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Product Status Box<\/title>\n    <style>\n        \n        .product-status-box {\n            border: 2px solid #1b3a57;\n            padding: 3px 15px;\n            font-size: 12px;\n            font-weight: bold;\n            color: #000;\n            display: inline-block;\n            text-align: center;\n            text-transform: uppercase;\nmargin-bottom: 10px;\nmargin-top: 10px;\n        }\n        .center-wrapper {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n        }\n    <\/style>\n<\/head>\n<body>\n    <div class=\"center-wrapper\">\n    <div class=\"product-status-box\">HOT PRODUCT | LOW STOCK<\/div>\n    <\/div>\n<\/body>\n<\/html>"}},"title":{"type":"title","settings":{"text_size":"h2","title_alignment":"left","uppercase_title":false,"margin_top":0,"margin_bottom":0}},"a6eb81db-40e4-43e0-972f-32db010a4a56":{"type":"rating_stars","settings":{"rating":4.8,"star_color":"#ffcc00","bg_stars_style":"full","bg_star_color":"#ececec","label":"4.9\/5.0 based on 2.783+ verified reviews","size":11,