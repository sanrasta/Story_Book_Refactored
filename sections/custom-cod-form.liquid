<style>
  /* ============================================
     STORYBOOK MAGIC - PREMIUM KEEPSAKE THEME
     "A storybook stage for magical keepsakes"
     Paper + Ink + Magic Amber + Story Gold
  ============================================ */
  
  :root {
    /* Core Brand - Premium Keepsake Feel */
    --sb-paper: #FFF7EB;         /* Warm paper background */
    --sb-page: #ffffff;          /* Clean page surface */
    --sb-ink: #0B1B2B;           /* Deep ink text */
    --sb-ink-muted: #516173;     /* Muted text */
    --sb-ink-light: #8B9CAD;     /* Light text */
    
    /* CTA - Magic Amber (reserved for actions) */
    --sb-cta: #F59E0B;
    --sb-cta-hover: #D97706;
    --sb-cta-glow: rgba(245, 158, 11, 0.3);
    
    /* Premium Accent - Story Gold (sparingly) */
    --sb-gold: #D4AF37;
    --sb-gold-light: #E8D48A;
    --sb-gold-glow: rgba(212, 175, 55, 0.2);
    
    /* Success */
    --sb-success: #10b981;
    
    /* Theme accents (dynamically set) */
    --theme-accent: var(--sb-cta);
    --theme-deep: var(--sb-ink);
    
    /* Borders & Inputs */
    --sb-border: rgba(11, 27, 43, 0.1);
    --sb-border-light: rgba(11, 27, 43, 0.06);
    --sb-input-bg: #f8f5f0;
    
    /* Radius & Shadows */
    --sb-radius: 16px;
    --sb-radius-sm: 10px;
    --sb-shadow: 0 4px 12px rgba(11, 27, 43, 0.06);
    --sb-shadow-lg: 0 12px 32px rgba(11, 27, 43, 0.1);
    --sb-shadow-gold: 0 4px 20px var(--sb-gold-glow);
    
    /* Legacy mappings for compatibility */
    --sb-primary: var(--sb-ink);
    --sb-primary-light: #1a2a3a;
    --sb-accent: var(--sb-cta);
    --sb-accent-hover: var(--sb-cta-hover);
    --sb-bg: var(--sb-paper);
    --sb-card: var(--sb-page);
    --sb-text: var(--sb-ink);
    --sb-text-muted: var(--sb-ink-muted);
  }

  .storybook-wrapper {
    background: var(--sb-paper);
    padding: 40px 16px;
    font-family: 'DM Sans', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  .storybook-card {
    max-width: 600px;
    margin: 0 auto;
  }

  /* MAGIC SECTION - Premium Keepsake Header */
  .magic-section {
    background: linear-gradient(135deg, var(--sb-ink) 0%, #1a2a3a 100%);
    border-radius: var(--sb-radius);
    padding: 48px 32px;
    text-align: center;
    margin-bottom: 28px;
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(212, 175, 55, 0.15);
  }

  .magic-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      radial-gradient(ellipse at top, rgba(212, 175, 55, 0.08) 0%, transparent 50%),
      url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23D4AF37' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    pointer-events: none;
  }

  .magic-badge {
    display: inline-block;
    background: linear-gradient(135deg, var(--sb-gold) 0%, var(--sb-gold-light) 100%);
    color: var(--sb-ink);
    font-size: 11px;
    font-weight: 700;
    padding: 6px 16px;
    border-radius: 20px;
    margin-bottom: 18px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    box-shadow: var(--sb-shadow-gold);
  }

  .magic-title {
    color: white;
    font-size: 30px;
    font-weight: 700;
    margin: 0 0 12px 0;
    line-height: 1.2;
    font-family: 'Crimson Pro', Georgia, serif;
  }

  .magic-subtitle {
    color: rgba(255,255,255,0.75);
    font-size: 16px;
    margin: 0 0 30px 0;
    line-height: 1.5;
  }

  /* MAGIC BUTTON - Primary CTA */
  .magic-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center; 
    background: linear-gradient(135deg, var(--sb-cta) 0%, var(--sb-cta-hover) 100%);
    color: white;
    border: none;
    padding: 18px 40px;
    font-size: 17px;
    font-weight: 700;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s ease;
    overflow: hidden;
    font-family: inherit;
    box-shadow: 0 4px 16px var(--sb-cta-glow);
  }
  
  .magic-button:hover {
    background: linear-gradient(135deg, var(--sb-cta-hover) 0%, #c2410c 100%);
    transform: translateY(-3px);
    box-shadow: 0 12px 32px var(--sb-cta-glow);
  }

  .btn-glow {
    position: absolute;
    inset: 0;
    background: linear-gradient(45deg, transparent, rgba(255,255,255,0.2), transparent);
    transform: translateX(-100%);
    animation: shimmer 2s infinite;
  }

  @keyframes shimmer {
    100% { transform: translateX(100%); }
  }

  .btn-content {
    display: flex;
    align-items: center;
    gap: 10px;
    position: relative;
    z-index: 1;
  }

  .wand-icon {
    animation: wiggle 1.5s ease-in-out infinite;
  }

  @keyframes wiggle {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(-8deg); }
    75% { transform: rotate(8deg); }
  }

  /* MAGIC FORM */
  .magic-form {
    margin-top: 28px;
    animation: slideIn 0.4s ease;
  }

  .magic-form.hidden { display: none; }

  @keyframes slideIn {
    from { opacity: 0; transform: translateY(-15px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .form-card {
    background: white;
    border-radius: var(--sb-radius);
    padding: 28px;
    text-align: left;
  }

  .form-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--sb-text);
    margin: 0 0 24px 0;
    text-align: center;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }

  .form-field {
    margin-bottom: 18px;
  }

  .form-field label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--sb-text);
    margin-bottom: 8px;
  }

  .optional {
    color: var(--sb-text-muted);
    font-weight: 400;
  }

  .form-field input[type="text"],
  .form-field select,
  .form-field textarea {
    width: 100%;
    padding: 12px 16px;
    border: 2px solid var(--sb-border);
    border-radius: var(--sb-radius-sm);
    font-size: 15px;
    font-family: inherit;
    background: var(--sb-input-bg);
    transition: all 0.2s;
    box-sizing: border-box;
  }

  .form-field input:focus,
  .form-field select:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: var(--sb-primary);
    background: white;
  }

  .form-field textarea {
    min-height: 80px;
    resize: vertical;
  }

  /* UPLOAD ZONE */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  .upload-zone {
    display: flex; 
    flex-direction: column;
    align-items: center; 
    justify-content: center;
    padding: 28px;
    border: 2px dashed var(--sb-border);
    border-radius: var(--sb-radius-sm);
    background: var(--sb-input-bg);
    cursor: pointer; 
    transition: all 0.2s; 
    text-align: center;
  }

  .upload-zone:hover {
    border-color: var(--sb-primary);
    background: white;
  }

  .upload-icon {
    color: var(--sb-text-muted);
    margin-bottom: 10px;
  }

  .upload-zone span {
    display: block;
  }

  #magicPhotoLabel {
    font-weight: 600;
    color: var(--sb-primary);
  }

  .upload-hint {
    font-size: 12px;
    color: var(--sb-text-muted);
    margin-top: 4px;
  }

  .photo-preview {
    margin-top: 12px;
    border-radius: var(--sb-radius-sm);
    overflow: hidden; 
    max-width: 120px;
  }

  .photo-preview.hidden { display: none; }

  .photo-preview img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ELEMENT CHIPS */
  .element-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .chip {
    cursor: pointer;
  }

  .chip input { display: none; }

  .chip span {
    display: inline-block;
    padding: 10px 16px;
    background: var(--sb-input-bg);
    border: 2px solid var(--sb-border);
    border-radius: 25px;
    font-size: 14px;
    font-weight: 500;
    transition: all 0.2s;
  }

  .chip:hover span {
    border-color: var(--sb-primary);
  }

  .chip input:checked + span {
    background: var(--sb-primary);
    border-color: var(--sb-primary);
    color: white;
  }

  /* GENERATE BUTTON */
  .generate-btn {
    width: 100%;
    background: var(--sb-primary);
    color: white;
    border: none;
    padding: 16px;
    font-size: 16px;
    font-weight: 700;
    border-radius: var(--sb-radius-sm);
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
  }

  .generate-btn:hover {
    background: var(--sb-primary-light);
  }

  .generate-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .generate-loading.hidden { display: none; }
  .generate-text { display: flex; align-items: center; justify-content: center; gap: 8px; }

  .spinner {
    width: 20px;
    height: 20px;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    100% { transform: rotate(360deg); }
  }

  /* COVER RESULT - Premium Reveal */
  .cover-result {
    margin-top: 28px;
    animation: revealIn 0.6s ease;
  }

  .cover-result.hidden { display: none; }

  @keyframes revealIn {
    from { 
      opacity: 0; 
      transform: scale(0.95);
    }
    to { 
      opacity: 1; 
      transform: scale(1);
    }
  }

  .result-card {
    background: linear-gradient(135deg, var(--sb-ink) 0%, #1a2a3a 100%);
    border-radius: var(--sb-radius);
    padding: 36px 28px;
    text-align: center;
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(212, 175, 55, 0.15);
  }

  /* Spotlight effect behind the cover */
  .result-card::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 300px;
    height: 300px;
    background: radial-gradient(ellipse at center, 
      rgba(212, 175, 55, 0.2) 0%, 
      rgba(245, 158, 11, 0.1) 40%,
      transparent 70%);
    animation: spotlightPulse 3s ease infinite;
    z-index: 0;
  }

  @keyframes spotlightPulse {
    0%, 100% { 
      transform: translate(-50%, -50%) scale(1);
      opacity: 1;
    }
    50% { 
      transform: translate(-50%, -50%) scale(1.1);
      opacity: 0.8;
    }
  }

  .result-badge {
    display: inline-block;
    background: linear-gradient(135deg, var(--sb-gold) 0%, var(--sb-gold-light) 100%);
    color: var(--sb-ink);
    font-size: 13px;
    font-weight: 700;
    padding: 8px 20px;
    border-radius: 20px;
    margin-bottom: 24px;
    position: relative;
    z-index: 1;
    box-shadow: var(--sb-shadow-gold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .cover-frame {
    max-width: 280px;
    margin: 0 auto;
    border-radius: var(--sb-radius);
    overflow: hidden;
    box-shadow: 
      0 20px 50px rgba(0, 0, 0, 0.4),
      0 0 40px var(--sb-gold-glow);
    position: relative;
    z-index: 1;
    animation: coverReveal 0.8s ease forwards;
    animation-delay: 0.2s;
    opacity: 0;
  }

  @keyframes coverReveal {
    0% { 
      opacity: 0;
      transform: scale(0.85) rotateY(-15deg);
    }
    100% { 
      opacity: 1;
      transform: scale(1) rotateY(0);
    }
  }

  .cover-frame img {
    width: 100%;
    height: auto;
    display: block;
  }

  .result-text {
    margin-top: 24px;
    color: rgba(255, 255, 255, 0.8);
    font-size: 15px;
    position: relative;
    z-index: 1;
    line-height: 1.5;
  }

  /* PACKAGE SECTION */
  .pack-section {
    background: var(--sb-card);
    border-radius: var(--sb-radius);
    padding: 32px 24px;
    box-shadow: var(--sb-shadow);
  }

  .section-header {
    text-align: center;
    margin-bottom: 28px;
  }

  .section-header h2 {
    font-size: 24px;
    font-weight: 700;
    color: var(--sb-text);
    margin: 0 0 6px 0;
  }

  .section-header p {
    color: var(--sb-text-muted);
    font-size: 14px;
    margin: 0;
  }

  /* PACKAGE CARDS */
  .package-grid {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 32px;
  }

  .package-card {
    position: relative;
    cursor: pointer;
  }

  .package-card input { display: none; }

  .card-inner {
    border: 2px solid var(--sb-border);
    border-radius: var(--sb-radius-sm);
    padding: 18px 20px;
    transition: all 0.2s;
    background: white;
  }

  .package-card:hover .card-inner {
    border-color: var(--sb-primary);
  }

  .package-card input:checked + .card-inner {
    border-color: var(--sb-primary);
    background: linear-gradient(to right, rgba(30, 58, 95, 0.03), transparent);
    box-shadow: 0 0 0 3px rgba(30, 58, 95, 0.1);
  }

  .popular-badge, .value-badge {
    position: absolute;
    top: -10px;
    right: 16px;
    padding: 5px 14px;
    font-size: 10px;
    font-weight: 700;
    border-radius: 12px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
  }

  .popular-badge {
    background: linear-gradient(135deg, var(--sb-gold) 0%, var(--sb-gold-light) 100%);
    color: var(--sb-ink);
    box-shadow: var(--sb-shadow-gold);
  }

  .value-badge {
    background: linear-gradient(135deg, var(--sb-cta) 0%, var(--sb-cta-hover) 100%);
    color: white;
    box-shadow: 0 4px 12px var(--sb-cta-glow);
  }

  .package-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
  }

  .package-name {
    font-size: 17px;
    font-weight: 700;
    color: var(--sb-text);
  }

  .package-price {
    font-size: 24px;
    font-weight: 800;
    color: var(--sb-primary);
  }

  .price-group {
    text-align: right;
  }

  .price-per {
    display: block;
    font-size: 12px;
    color: var(--sb-success);
    font-weight: 600;
    margin-top: 2px;
  }

  .package-features {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .package-features li {
    font-size: 13px;
    color: var(--sb-text-muted);
    padding: 3px 0;
  }

  /* ORDER FORM */
  .order-form {
    border-top: 1px solid var(--sb-border);
    padding-top: 28px;
  }

  .order-form h3 {
    font-size: 18px;
    font-weight: 700;
    color: var(--sb-text);
    margin: 0 0 20px 0;
  }

  .input-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .input-field {
    margin-bottom: 0;
  }

  .input-field.full-width {
    grid-column: 1 / -1;
  }

  .input-field label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--sb-text);
    margin-bottom: 8px;
  }

  .input-field input,
  .input-field select {
    width: 100%; 
    padding: 12px 14px;
    border: 2px solid var(--sb-border);
    border-radius: var(--sb-radius-sm);
    font-size: 15px;
    font-family: inherit;
    background: white;
    transition: all 0.2s;
    box-sizing: border-box;
  }

  .input-field input:focus,
  .input-field select:focus {
    outline: none;
    border-color: var(--sb-primary);
  }

  .phone-input {
    display: flex;
    gap: 10px;
  }

  .phone-input select {
    width: 110px;
    flex-shrink: 0;
  }

  .phone-input input {
    flex: 1;
  }

  /* TRUST BADGES */
  .trust-badges {
    display: flex;
    justify-content: center;
    gap: 24px;
    margin: 28px 0;
    padding: 20px;
    background: var(--sb-input-bg);
    border-radius: var(--sb-radius-sm);
  }

  .trust-badges .badge {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--sb-text-muted);
  }

  .trust-badges svg {
    color: var(--sb-success);
  }

  /* SUBMIT BUTTON - Primary CTA */
  .submit-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: linear-gradient(135deg, var(--sb-cta) 0%, var(--sb-cta-hover) 100%);
    color: white;
    border: none;
    padding: 20px;
    font-size: 18px;
    font-weight: 700;
    border-radius: var(--sb-radius-sm);
    cursor: pointer;
    transition: all 0.3s;
    font-family: inherit;
    box-shadow: 0 4px 16px var(--sb-cta-glow);
    position: relative;
    overflow: hidden;
  }

  .submit-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: left 0.5s ease;
  }

  .submit-btn:hover::before {
    left: 100%;
  }

  .submit-btn:hover {
    background: linear-gradient(135deg, var(--sb-cta-hover) 0%, #c2410c 100%);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px var(--sb-cta-glow);
  }

  .guarantee {
    text-align: center;
    font-size: 13px;
    color: var(--sb-text-muted);
    margin: 16px 0 0 0;
  }

  /* MODAL */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    padding: 20px;
  }

  .modal-overlay.hidden { display: none; }

  .modal-content {
    background: white;
    border-radius: var(--sb-radius);
    padding: 40px;
    max-width: 400px;
    text-align: center;
    animation: modalIn 0.3s ease;
  }

  @keyframes modalIn {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }

  .success-icon {
    width: 64px;
    height: 64px;
    background: var(--sb-success);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    color: white;
  }

  .success-icon svg {
    width: 32px;
    height: 32px;
  }

  .modal-content h3 {
    font-size: 22px;
    margin: 0 0 12px 0;
    color: var(--sb-text);
  }

  .modal-content p {
    color: var(--sb-text-muted);
    margin: 0 0 24px 0;
    line-height: 1.5;
  }

  .modal-btn {
    background: var(--sb-primary);
    color: white;
    border: none;
    padding: 12px 32px;
    font-size: 15px;
    font-weight: 600;
    border-radius: 25px;
    cursor: pointer;
    font-family: inherit;
  }

  /* RESPONSIVE */
  @media (max-width: 600px) {
    .storybook-wrapper { padding: 20px 12px; }
    .magic-section { padding: 30px 20px; }
    .magic-title { font-size: 24px; }
    .form-grid { grid-template-columns: 1fr; }
    .input-grid { grid-template-columns: 1fr; }
    .input-field.full-width { grid-column: 1; }
    .trust-badges { flex-direction: column; gap: 12px; align-items: center; }
    .package-header { flex-direction: column; gap: 8px; }
    .price-group { text-align: left; }
  }
</style>

<script>
  // ============================================
  // DYNAMIC CURRENCY DETECTION
  // ============================================
  const currencyMap = {
    US: { symbol: '$', code: 'usd' },
    CA: { symbol: 'C$', code: 'cad' },
    GB: { symbol: '£', code: 'gbp' },
    AU: { symbol: 'A$', code: 'aud' },
    DE: { symbol: '€', code: 'eur' },
    FR: { symbol: '€', code: 'eur' },
    ES: { symbol: '€', code: 'eur' },
    IT: { symbol: '€', code: 'eur' },
    NL: { symbol: '€', code: 'eur' },
    BE: { symbol: '€', code: 'eur' },
    AT: { symbol: '€', code: 'eur' },
    IE: { symbol: '€', code: 'eur' },
    NZ: { symbol: 'NZ$', code: 'aud' },
    SG: { symbol: 'S$', code: 'usd' },
    AE: { symbol: '$', code: 'usd' },
    JP: { symbol: '¥', code: 'usd' }
  };

  let currentCurrency = { symbol: '$', code: 'usd' };

  // Detect currency from timezone/locale
  function detectCurrency() {
    try {
      const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
      const locale = navigator.language || 'en-US';
      
      // Simple detection based on common patterns
      if (timezone.includes('London') || locale.startsWith('en-GB')) {
        return currencyMap.GB;
      } else if (timezone.includes('Sydney') || timezone.includes('Melbourne') || locale.includes('AU')) {
        return currencyMap.AU;
      } else if (timezone.includes('Toronto') || timezone.includes('Vancouver') || locale.includes('CA')) {
        return currencyMap.CA;
      } else if (timezone.includes('Paris') || timezone.includes('Berlin') || locale.startsWith('de') || locale.startsWith('fr')) {
        return currencyMap.DE;
      }
      return currencyMap.US;
    } catch (e) {
      return currencyMap.US;
    }
  }

  // Update all prices on page
  function updatePrices() {
    const packages = document.querySelectorAll('input[name="package"]');
    const symbols = document.querySelectorAll('.currency-symbol');
    
    symbols.forEach(s => s.textContent = currentCurrency.symbol);
    
    packages.forEach(pkg => {
      const price = pkg.dataset['price' + currentCurrency.code.charAt(0).toUpperCase() + currentCurrency.code.slice(1)];
      const priceDisplay = pkg.parentElement.querySelector('.price-value');
      if (priceDisplay && price) {
        priceDisplay.textContent = price;
      }
    });
    
    updateTotal();
  }

  function updateTotal() {
    const selected = document.querySelector('input[name="package"]:checked');
    if (selected) {
      const price = selected.dataset['price' + currentCurrency.code.charAt(0).toUpperCase() + currentCurrency.code.slice(1)];
      document.querySelector('.total-price').textContent = price;
    }
  }

  // Country change updates currency
  document.getElementById('countrySelect').addEventListener('change', function() {
    const country = this.value;
    if (currencyMap[country]) {
      currentCurrency = currencyMap[country];
      updatePrices();
    }
  });

  // Package selection updates total
  document.querySelectorAll('input[name="package"]').forEach(input => {
    input.addEventListener('change', updateTotal);
  });

  // ============================================
  // MAGIC COVER GENERATOR
  // ============================================
  const magicBtn = document.getElementById('magicBtn');
  const magicForm = document.getElementById('magicForm');
  const generateCoverBtn = document.getElementById('generateCoverBtn');
  const coverResult = document.getElementById('coverResult');
  const generatedCover = document.getElementById('generatedCover');
  const magicPhotoInput = document.getElementById('magicPhoto');
  const magicPhotoLabel = document.getElementById('magicPhotoLabel');
  const magicPhotoPreview = document.getElementById('magicPhotoPreview');

  magicBtn.addEventListener('click', function() {
    magicForm.classList.remove('hidden');
    this.style.display = 'none';
    magicForm.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  magicPhotoInput.addEventListener('change', function() {
    if (this.files && this.files[0]) {
      const file = this.files[0];
      if (file.size > 5 * 1024 * 1024) {
        alert('Photo too large. Max 5MB allowed.');
        this.value = '';
        return;
      }
      
      magicPhotoLabel.textContent = 'Photo added ✓';
      magicPhotoLabel.style.color = 'var(--sb-success)';
      
      const reader = new FileReader();
      reader.onload = function(e) {
        magicPhotoPreview.innerHTML = '<img src="' + e.target.result + '" alt="Preview">';
        magicPhotoPreview.classList.remove('hidden');
      };
      reader.readAsDataURL(file);
    }
  });

  generateCoverBtn.addEventListener('click', function() {
    const name = document.getElementById('magicName').value;
    
    if (!name.trim()) {
      alert("Please enter the child's name");
      return;
    }

    const btn = this;
    const textEl = btn.querySelector('.generate-text');
    const loadingEl = btn.querySelector('.generate-loading');
    
    btn.disabled = true;
    textEl.classList.add('hidden');
    loadingEl.classList.remove('hidden');

    // Mock API call - replace with real n8n webhook
    setTimeout(() => {
      generatedCover.src = 'https://placehold.co/400x500/1e3a5f/ffffff?text=' + encodeURIComponent(name + "'s\\nAdventure");
      
      magicForm.classList.add('hidden');
      coverResult.classList.remove('hidden');
      
      setTimeout(() => {
        document.getElementById('packSection').scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 800);

      btn.disabled = false;
      textEl.classList.remove('hidden');
      loadingEl.classList.add('hidden');
    }, 2500);
  });

  // ============================================
  // FORM SUBMISSION
  // ============================================
  const orderForm = document.getElementById('orderForm');
  const submitBtn = document.getElementById('submitBtn');
  const successModal = document.getElementById('successModal');

  orderForm.addEventListener('submit', function(e) {
    e.preventDefault();
    
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span>Processing...</span>';

    // Mock submission
    setTimeout(() => {
      successModal.classList.remove('hidden');
      orderForm.reset();
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<span class="btn-text">Complete Order</span><span class="btn-price">• <span class="currency-symbol">' + currentCurrency.symbol + '</span><span class="total-price">49</span></span>';
    }, 1500);
  });

  // ============================================
  // INIT
  // ============================================
  currentCurrency = detectCurrency();
  updatePrices();
</script>

