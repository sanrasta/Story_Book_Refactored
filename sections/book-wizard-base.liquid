  }

  /* SUBMIT BUTTON */
  .submit-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: linear-gradient(135deg, var(--wizard-accent) 0%, var(--wizard-accent-hover) 100%);
    color: white;
    border: none;
    padding: 20px;
    font-size: 18px;
    font-weight: 700;
    border-radius: var(--wizard-radius-sm);
    cursor: pointer;
    transition: all 0.3s;
    font-family: inherit;
    box-shadow: 0 4px 16px var(--wizard-accent-glow);
    position: relative;
    overflow: hidden;
  }

  .submit-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: left 0.5s ease;
  }

  .submit-btn:hover::before {
    left: 100%;
