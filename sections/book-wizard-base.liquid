    z-index: 1;
    box-shadow: 0 4px 20px var(--wizard-gold-glow);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .cover-frame {
    max-width: 280px;
    margin: 0 auto;
    border-radius: var(--wizard-radius);
    overflow: hidden;
